# Copy to .env.local and fill in. Never commit a real value.

# --- Database -------------------------------------------------------------
# Matches docker-compose.dev.yml. Use a real password in production.
DATABASE_URL=postgres://sse_shop:sse_shop@localhost:5433/sse_shop
# Disposable database used by integration tests. Never point this at real data.
DATABASE_URL_TEST=postgres://sse_shop:sse_shop@localhost:5433/sse_shop_test

# --- Auth -----------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call Better Auth, comma separated. Usually empty.
BETTER_AUTH_TRUSTED_ORIGINS=
# Keep true in production. Playwright sets this to false for its sign-in-heavy suite.
BETTER_AUTH_RATE_LIMIT=true
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# --- Hosts ----------------------------------------------------------------
NEXT_PUBLIC_STORE_URL=http://localhost:3000
ADMIN_HOST=admin.localhost
# Keep true in production. Set false only for local development.
ADMIN_REQUIRE_TWO_FACTOR=true

# --- Media ----------------------------------------------------------------
# Local default. docker-compose.yml overrides this with /data/uploads.
UPLOADS_DIR=./data/uploads
MEDIA_BASE_URL=http://localhost:3000/media
# --- Admin network gate ---------------------------------------------------
# Generate the hash with: caddy hash-password --plaintext 'your-password'
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_HASH=

# --- Payments -------------------------------------------------------------
# mock only until the deploy-ready phase. Setting stripe fails loudly.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mail -----------------------------------------------------------------
# console only until the deploy-ready phase. Setting smtp fails loudly.
MAIL_DRIVER=console
SMTP_URL=

# --- End-to-end -----------------------------------------------------------
E2E_BASE_URL=http://localhost:3100
# Keep E2E_ADMIN_* in step with ADMIN_EMAIL/ADMIN_PASSWORD when seeding a fresh database.
E2E_ADMIN_EMAIL=owner@example.com
E2E_ADMIN_PASSWORD=
E2E_ADMIN_TOTP_SECRET=

# --- Production only (docker compose) -------------------------------------
# Used by docker-compose.yml, not by the dev server.
POSTGRES_PASSWORD=
STORE_DOMAIN=
ADMIN_DOMAIN=
