# Two hostnames, one app. Caddy terminates TLS and routes by host.

{$STORE_DOMAIN:localhost} {
	encode zstd gzip

	# Product images: immutable filenames, long cache, no authorization needed.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}

{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip

	# Second gate in front of the app. Uncomment once ADMIN_BASIC_AUTH_HASH is
	# set to a bcrypt hash from `caddy hash-password --plaintext '...'`.
	# basicauth {
	# 	{$ADMIN_BASIC_AUTH_USER:admin} {$ADMIN_BASIC_AUTH_HASH}
	# }

	handle {
		reverse_proxy web:3000
	}
}
